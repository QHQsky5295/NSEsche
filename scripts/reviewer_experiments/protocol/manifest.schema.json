{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tsc-reviewer-run-manifest.schema.json",
  "title": "TSC reviewer experiment run manifest",
  "type": "object",
  "required": [
    "schema_version",
    "protocol_id",
    "created_at",
    "seed_stage",
    "common_hpa",
    "common_hpa_hash",
    "workload_profile_set",
    "workload_profile_set_hash",
    "execution",
    "qc",
    "runs",
    "reference_build_dependencies",
    "all_faasrank_models_bound",
    "all_sla_targets_bound",
    "reuse_analyses",
    "manifest_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "protocol_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "seed_stage": {"enum": ["initial", "ci_extension", "all"]},
    "formal_results_eligible": {"type": "boolean"},
    "formal_e1_homogeneous_shard": {
      "$ref": "#/$defs/formalE1HomogeneousShard"
    },
    "formal_e1_heterogeneous_shard": {
      "$ref": "#/$defs/formalE1HeterogeneousShard"
    },
    "formal_e2_weak_scaling_shard": {
      "$ref": "#/$defs/formalE2WeakScalingShard"
    },
    "formal_e2_nsesche_profile_overlay": {
      "$ref": "#/$defs/formalE2NSEScheProfileOverlay"
    },
    "formal_e3_e4_initial_shard": {
      "$ref": "#/$defs/formalE3E4InitialShard"
    },
    "formal_e3_e4_ci_extension_shard": {
      "$ref": "#/$defs/formalE3E4CIExtensionShard"
    },
    "formal_e5_e6_e7_initial_shard": {
      "$ref": "#/$defs/formalE5E6E7InitialShard"
    },
    "formal_e5_e6_ci_extension_shard": {
      "$ref": "#/$defs/formalE5E6CIExtensionShard"
    },
    "common_hpa": {"type": "object"},
    "common_hpa_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "workload_profile_set": {
      "type": "object",
      "required": ["schema_version", "profile_set_id", "formal_required", "profiles"],
      "properties": {
        "schema_version": {"const": "NSE_WORKLOAD_FREQUENCY_PROFILE_SET_V1"},
        "profile_set_id": {"const": "submission-era-azure-cdf-v1"},
        "formal_required": {"const": true},
        "profiles": {
          "type": "object",
          "required": ["low", "middle", "high"],
          "properties": {
            "low": {"$ref": "#/$defs/workloadProfileBinding"},
            "middle": {"$ref": "#/$defs/workloadProfileBinding"},
            "high": {"$ref": "#/$defs/workloadProfileBinding"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "workload_profile_set_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution": {
      "type": "object",
      "required": ["command_template", "cwd", "timeout_seconds", "max_attempts", "result_relative_path"],
      "properties": {
        "command_template": {"type": "array", "items": {"type": "string"}},
        "cwd": {"type": "string"},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "max_attempts": {"const": 3},
        "result_relative_path": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "qc": {"type": "object"},
    "runs": {
      "type": "array",
      "items": {"$ref": "#/$defs/run"}
    },
    "reference_build_dependencies": {
      "type": "array",
      "items": {"$ref": "#/$defs/referenceDependency"}
    },
    "all_faasrank_models_bound": {"type": "boolean"},
    "all_sla_targets_bound": {"type": "boolean"},
    "reuse_analyses": {
      "type": "array",
      "items": {"$ref": "#/$defs/reuseAnalysis"}
    },
    "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "formalE1HomogeneousShard": {
      "type": "object",
      "required": [
        "schema_version",
        "source_manifest",
        "selection",
        "selected_source_runs",
        "sealed_reuse_rules",
        "selected_run_count",
        "selected_cell_count",
        "selected_reference_build_count"
      ],
      "properties": {
        "schema_version": {"const": "NSE_FORMAL_E1_HOMOGENEOUS_SHARD_V1"},
        "source_manifest": {
          "type": "object",
          "required": [
            "path",
            "manifest_hash",
            "file_sha256",
            "protocol_id",
            "run_count",
            "seed_stage"
          ],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "protocol_id": {"type": "string", "minLength": 1},
            "run_count": {"type": "integer", "minimum": 1},
            "seed_stage": {"enum": ["initial", "ci_extension", "all"]}
          },
          "additionalProperties": false
        },
        "selection": {
          "type": "object",
          "required": [
            "experiment_id",
            "cluster_topology",
            "node_count",
            "methods",
            "loads",
            "seeds"
          ],
          "properties": {
            "experiment_id": {"const": "E1"},
            "cluster_topology": {"const": "homogeneous"},
            "node_count": {"const": 20},
            "methods": {
              "type": "array",
              "items": {"type": "string"},
              "minItems": 10,
              "maxItems": 10,
              "uniqueItems": true
            },
            "loads": {
              "type": "array",
              "items": {"enum": ["low", "middle", "high"]},
              "minItems": 3,
              "maxItems": 3,
              "uniqueItems": true
            },
            "seeds": {
              "type": "array",
              "items": {"pattern": "^E[0-9]{2,3}$"},
              "minItems": 10,
              "maxItems": 20,
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "selected_source_runs": {
          "type": "array",
          "items": {"$ref": "#/$defs/formalE1SourceRun"},
          "minItems": 300,
          "maxItems": 600
        },
        "sealed_reuse_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rule_id", "rule_sha256"],
            "properties": {
              "rule_id": {"type": "string", "minLength": 1},
              "rule_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            },
            "additionalProperties": false
          }
        },
        "selected_run_count": {"enum": [300, 600]},
        "selected_cell_count": {"const": 30},
        "selected_reference_build_count": {"enum": [30, 60]}
      },
      "additionalProperties": false
    },
    "formalE1HeterogeneousShard": {
      "type": "object",
      "required": [
        "schema_version",
        "source_manifest",
        "selection",
        "selected_source_runs",
        "sealed_reuse_rules",
        "selected_run_count",
        "selected_cell_count",
        "selected_reference_build_count"
      ],
      "properties": {
        "schema_version": {"const": "NSE_FORMAL_E1_HETEROGENEOUS_SHARD_V1"},
        "source_manifest": {
          "type": "object",
          "required": [
            "path",
            "manifest_hash",
            "file_sha256",
            "protocol_id",
            "run_count",
            "seed_stage"
          ],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "protocol_id": {"type": "string", "minLength": 1},
            "run_count": {"type": "integer", "minimum": 1},
            "seed_stage": {"enum": ["initial", "ci_extension", "all"]}
          },
          "additionalProperties": false
        },
        "selection": {
          "type": "object",
          "required": [
            "experiment_id",
            "cluster_topology",
            "node_count",
            "methods",
            "loads",
            "seeds"
          ],
          "properties": {
            "experiment_id": {"const": "E1"},
            "cluster_topology": {"const": "heterogeneous"},
            "node_count": {"const": 20},
            "methods": {
              "type": "array",
              "items": {"type": "string"},
              "minItems": 10,
              "maxItems": 10,
              "uniqueItems": true
            },
            "loads": {
              "type": "array",
              "items": {"enum": ["low", "middle", "high"]},
              "minItems": 3,
              "maxItems": 3,
              "uniqueItems": true
            },
            "seeds": {
              "type": "array",
              "items": {"pattern": "^E[0-9]{2,3}$"},
              "minItems": 10,
              "maxItems": 20,
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "selected_source_runs": {
          "type": "array",
          "items": {"$ref": "#/$defs/formalE1SourceRun"},
          "minItems": 300,
          "maxItems": 600
        },
        "sealed_reuse_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rule_id", "rule_sha256"],
            "properties": {
              "rule_id": {"type": "string", "minLength": 1},
              "rule_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            },
            "additionalProperties": false
          }
        },
        "selected_run_count": {"enum": [300, 600]},
        "selected_cell_count": {"const": 30},
        "selected_reference_build_count": {"enum": [30, 60]}
      },
      "additionalProperties": false
    },
    "formalE2NSEScheProfileOverlay": {
      "type": "object",
      "required": [
        "schema_version",
        "plan",
        "source_manifests",
        "selection",
        "selected_profile",
        "selected_source_runs",
        "frozen_baseline_runs",
        "historical_nsesche_runs",
        "versioned_runtime_contract",
        "frozen_baseline_runtime",
        "selected_run_count",
        "selected_cell_count",
        "selected_reference_build_count",
        "frozen_baseline_run_count",
        "historical_nsesche_run_count",
        "performance_results_consulted"
      ],
      "properties": {
        "schema_version": {
          "const": "NSE_FORMAL_E2_NSESCHE_PROFILE_OVERLAY_V1"
        },
        "plan": {"type": "object"},
        "source_manifests": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "object"}
        },
        "selection": {"type": "object"},
        "selected_profile": {"type": "object"},
        "selected_source_runs": {
          "type": "array",
          "minItems": 20,
          "maxItems": 20,
          "items": {"type": "object"}
        },
        "frozen_baseline_runs": {
          "type": "array",
          "minItems": 180,
          "maxItems": 180,
          "items": {"type": "object"}
        },
        "historical_nsesche_runs": {
          "type": "array",
          "minItems": 20,
          "maxItems": 20,
          "items": {"type": "object"}
        },
        "versioned_runtime_contract": {"type": "object"},
        "frozen_baseline_runtime": {"type": "object"},
        "selected_run_count": {"const": 20},
        "selected_cell_count": {"const": 1},
        "selected_reference_build_count": {"const": 20},
        "frozen_baseline_run_count": {"const": 180},
        "historical_nsesche_run_count": {"const": 20},
        "performance_results_consulted": {"const": false}
      },
      "additionalProperties": false
    },
    "formalE2WeakScalingShard": {
      "type": "object",
      "required": [
        "schema_version",
        "source_manifest",
        "selection",
        "selected_source_runs",
        "e1_reuse_source_runs",
        "sealed_e1_reuse_rule",
        "sealed_reuse_rules",
        "selected_run_count",
        "selected_cell_count",
        "selected_reference_build_count",
        "e1_reuse_source_run_count",
        "e1_reuse_source_cell_count"
      ],
      "properties": {
        "schema_version": {"const": "NSE_FORMAL_E2_WEAK_SCALING_SHARD_V1"},
        "source_manifest": {
          "type": "object",
          "required": [
            "path",
            "manifest_hash",
            "file_sha256",
            "protocol_id",
            "run_count",
            "seed_stage"
          ],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "protocol_id": {"type": "string", "minLength": 1},
            "run_count": {"type": "integer", "minimum": 1},
            "seed_stage": {"enum": ["initial", "ci_extension", "all"]}
          },
          "additionalProperties": false
        },
        "selection": {
          "type": "object",
          "required": [
            "experiment_id",
            "cluster_topology",
            "node_scales",
            "methods",
            "loads",
            "seeds"
          ],
          "properties": {
            "experiment_id": {"const": "E2"},
            "cluster_topology": {"const": "homogeneous"},
            "node_scales": {
              "const": [
                {"node_count": 100, "load_scale": 5.0},
                {"node_count": 500, "load_scale": 25.0}
              ]
            },
            "methods": {
              "type": "array",
              "items": {"type": "string"},
              "minItems": 10,
              "maxItems": 10,
              "uniqueItems": true
            },
            "loads": {
              "type": "array",
              "items": {"enum": ["low", "middle", "high"]},
              "minItems": 3,
              "maxItems": 3,
              "uniqueItems": true
            },
            "seeds": {
              "type": "array",
              "items": {"pattern": "^E[0-9]{2,3}$"},
              "minItems": 10,
              "maxItems": 20,
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "selected_source_runs": {
          "type": "array",
          "items": {"$ref": "#/$defs/formalE1SourceRun"},
          "minItems": 600,
          "maxItems": 1200
        },
        "e1_reuse_source_runs": {
          "type": "array",
          "items": {"$ref": "#/$defs/formalE1ReuseSourceRun"},
          "minItems": 300,
          "maxItems": 600
        },
        "sealed_e1_reuse_rule": {"$ref": "#/$defs/sealedReuseRule"},
        "sealed_reuse_rules": {
          "type": "array",
          "items": {"$ref": "#/$defs/sealedReuseRule"}
        },
        "selected_run_count": {"enum": [600, 1200]},
        "selected_cell_count": {"const": 60},
        "selected_reference_build_count": {"enum": [60, 120]},
        "e1_reuse_source_run_count": {"enum": [300, 600]},
        "e1_reuse_source_cell_count": {"const": 30}
      },
      "additionalProperties": false
    },
    "formalE3E4InitialShard": {
      "type": "object",
      "required": [
        "schema_version",
        "source_manifest",
        "selection",
        "execution_prerequisites",
        "selected_source_runs",
        "sealed_reuse_rules",
        "selected_run_count",
        "selected_cell_count",
        "selected_e3_run_count",
        "selected_e4_run_count",
        "selected_reference_build_count",
        "selected_balanced_qos_run_count",
        "selected_faasrank_run_count"
      ],
      "properties": {
        "schema_version": {"const": "NSE_FORMAL_E3_E4_INITIAL_SHARD_V1"},
        "source_manifest": {
          "type": "object",
          "required": ["path", "manifest_hash", "file_sha256", "protocol_id", "run_count", "seed_stage"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "protocol_id": {"type": "string", "minLength": 1},
            "run_count": {"const": 1820},
            "seed_stage": {"const": "initial"}
          },
          "additionalProperties": false
        },
        "selection": {
          "type": "object",
          "required": ["experiment_ids", "methods", "seeds", "common_cluster", "base_load", "qos_profile", "E3", "E4"],
          "properties": {
            "experiment_ids": {"const": ["E3", "E4"]},
            "methods": {
              "const": ["greedy", "random", "hash", "load_least", "sche_FaaSRank", "sche_OCS", "sche_Hiku", "sche_jiagu", "sche_orion", "sche_nash"]
            },
            "seeds": {
              "const": ["E01", "E02", "E03", "E04", "E05", "E06", "E07", "E08", "E09", "E10"]
            },
            "common_cluster": {"const": {"node_count": 20, "topology": "heterogeneous"}},
            "base_load": {"const": "middle"},
            "qos_profile": {"const": "balanced"},
            "E3": {
              "const": {
                "burst_scenarios": [
                  {"name": "spike5x50ms", "kind": "spike", "multiplier": 5.0, "duration_ms": 50, "repetitions": 1},
                  {"name": "sustained3x200ms", "kind": "sustained", "multiplier": 3.0, "duration_ms": 200, "repetitions": 1},
                  {"name": "pulse4x4x50ms", "kind": "pulse", "multiplier": 4.0, "duration_ms": 50, "repetitions": 4}
                ],
                "arrival_horizon_frames": 1000,
                "observation_horizon_frames": 1000,
                "total_frame": 4000
              }
            },
            "E4": {
              "const": {
                "arrival_profile": "steady",
                "arrival_horizon_frames": 1000,
                "observation_horizon_frames": 1000,
                "total_frame": 1000,
                "per_qos_breakdown_required": true
              }
            }
          },
          "additionalProperties": false
        },
        "execution_prerequisites": {
          "const": {
            "workload_tapes": "required_before_execution",
            "sla_targets": "required_before_execution_from_E1_pilot_artifact",
            "faasrank_model": "required_before_execution",
            "offline_references": "required_before_execution"
          }
        },
        "selected_source_runs": {
          "type": "array",
          "items": {"$ref": "#/$defs/formalShardSourceRun"},
          "minItems": 400,
          "maxItems": 400
        },
        "sealed_reuse_rules": {"type": "array", "items": {"$ref": "#/$defs/sealedReuseRule"}},
        "selected_run_count": {"const": 400},
        "selected_cell_count": {"const": 40},
        "selected_e3_run_count": {"const": 300},
        "selected_e4_run_count": {"const": 100},
        "selected_reference_build_count": {"const": 40},
        "selected_balanced_qos_run_count": {"const": 400},
        "selected_faasrank_run_count": {"const": 40}
      },
      "additionalProperties": false
    },
    "formalE3E4CIExtensionShard": {
