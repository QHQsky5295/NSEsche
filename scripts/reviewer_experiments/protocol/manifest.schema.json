            "E3": {
              "const": {
                "burst_scenarios": [
                  {"name": "spike5x50ms", "kind": "spike", "multiplier": 5.0, "duration_ms": 50, "repetitions": 1},
                  {"name": "sustained3x200ms", "kind": "sustained", "multiplier": 3.0, "duration_ms": 200, "repetitions": 1},
                  {"name": "pulse4x4x50ms", "kind": "pulse", "multiplier": 4.0, "duration_ms": 50, "repetitions": 4}
