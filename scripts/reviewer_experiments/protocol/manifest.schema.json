{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tsc-reviewer-run-manifest.schema.json",
  "title": "TSC reviewer experiment run manifest",
  "type": "object",
  "required": [
    "schema_version",
    "protocol_id",
    "created_at",
    "seed_stage",
    "common_hpa",
    "common_hpa_hash",
    "workload_profile_set",
    "workload_profile_set_hash",
    "execution",
    "qc",
    "runs",
    "reference_build_dependencies",
    "all_faasrank_models_bound",
    "all_sla_targets_bound",
    "reuse_analyses",
    "manifest_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "protocol_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "seed_stage": {"enum": ["initial", "ci_extension", "all"]},
    "formal_results_eligible": {"type": "boolean"},
    "formal_e1_homogeneous_shard": {
      "$ref": "#/$defs/formalE1HomogeneousShard"
    },
    "formal_e1_heterogeneous_shard": {
      "$ref": "#/$defs/formalE1HeterogeneousShard"
    },
    "common_hpa": {"type": "object"},
    "common_hpa_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "workload_profile_set": {
      "type": "object",
      "required": ["schema_version", "profile_set_id", "formal_required", "profiles"],
      "properties": {
        "schema_version": {"const": "NSE_WORKLOAD_FREQUENCY_PROFILE_SET_V1"},
        "profile_set_id": {"const": "submission-era-azure-cdf-v1"},
        "formal_required": {"const": true},
        "profiles": {
          "type": "object",
          "required": ["low", "middle", "high"],
          "properties": {
            "low": {"$ref": "#/$defs/workloadProfileBinding"},
            "middle": {"$ref": "#/$defs/workloadProfileBinding"},
            "high": {"$ref": "#/$defs/workloadProfileBinding"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "workload_profile_set_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution": {
      "type": "object",
      "required": ["command_template", "cwd", "timeout_seconds", "max_attempts", "result_relative_path"],
      "properties": {
        "command_template": {"type": "array", "items": {"type": "string"}},
        "cwd": {"type": "string"},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "max_attempts": {"const": 3},
        "result_relative_path": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "qc": {"type": "object"},
    "runs": {
      "type": "array",
      "items": {"$ref": "#/$defs/run"}
    },
    "reference_build_dependencies": {
      "type": "array",
      "items": {"$ref": "#/$defs/referenceDependency"}
    },
    "all_faasrank_models_bound": {"type": "boolean"},
    "all_sla_targets_bound": {"type": "boolean"},
    "reuse_analyses": {
      "type": "array",
      "items": {"$ref": "#/$defs/reuseAnalysis"}
    },
    "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "formalE1HomogeneousShard": {
      "type": "object",
      "required": [
        "schema_version",
        "source_manifest",
        "selection",
        "selected_source_runs",
        "sealed_reuse_rules",
        "selected_run_count",
        "selected_cell_count",
        "selected_reference_build_count"
      ],
      "properties": {
        "schema_version": {"const": "NSE_FORMAL_E1_HOMOGENEOUS_SHARD_V1"},
        "source_manifest": {
          "type": "object",
          "required": [
            "path",
            "manifest_hash",
            "file_sha256",
            "protocol_id",
            "run_count",
            "seed_stage"
          ],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "protocol_id": {"type": "string", "minLength": 1},
            "run_count": {"type": "integer", "minimum": 1},
            "seed_stage": {"enum": ["initial", "ci_extension", "all"]}
          },
          "additionalProperties": false
        },
        "selection": {
          "type": "object",
          "required": [
            "experiment_id",
            "cluster_topology",
            "node_count",
            "methods",
            "loads",
            "seeds"
          ],
          "properties": {
            "experiment_id": {"const": "E1"},
            "cluster_topology": {"const": "homogeneous"},
            "node_count": {"const": 20},
            "methods": {
              "type": "array",
              "items": {"type": "string"},
              "minItems": 10,
              "maxItems": 10,
              "uniqueItems": true
            },
            "loads": {
              "type": "array",
              "items": {"enum": ["low", "middle", "high"]},
              "minItems": 3,
              "maxItems": 3,
              "uniqueItems": true
            },
            "seeds": {
              "type": "array",
              "items": {"pattern": "^E[0-9]{2}$"},
              "minItems": 10,
              "maxItems": 20,
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "selected_source_runs": {
          "type": "array",
          "items": {"$ref": "#/$defs/formalE1SourceRun"},
          "minItems": 300,
          "maxItems": 600
        },
        "sealed_reuse_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rule_id", "rule_sha256"],
            "properties": {
              "rule_id": {"type": "string", "minLength": 1},
              "rule_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            },
            "additionalProperties": false
          }
        },
        "selected_run_count": {"enum": [300, 600]},
        "selected_cell_count": {"const": 30},
        "selected_reference_build_count": {"enum": [30, 60]}
      },
      "additionalProperties": false
    },
    "formalE1HeterogeneousShard": {
      "type": "object",
      "required": [
        "schema_version",
        "source_manifest",
        "selection",
        "selected_source_runs",
        "sealed_reuse_rules",
        "selected_run_count",
        "selected_cell_count",
        "selected_reference_build_count"
      ],
      "properties": {
        "schema_version": {"const": "NSE_FORMAL_E1_HETEROGENEOUS_SHARD_V1"},
        "source_manifest": {
          "type": "object",
          "required": [
            "path",
            "manifest_hash",
            "file_sha256",
            "protocol_id",
            "run_count",
            "seed_stage"
          ],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "protocol_id": {"type": "string", "minLength": 1},
            "run_count": {"type": "integer", "minimum": 1},
            "seed_stage": {"enum": ["initial", "ci_extension", "all"]}
          },
          "additionalProperties": false
        },
        "selection": {
          "type": "object",
          "required": [
            "experiment_id",
            "cluster_topology",
            "node_count",
            "methods",
            "loads",
            "seeds"
          ],
          "properties": {
            "experiment_id": {"const": "E1"},
            "cluster_topology": {"const": "heterogeneous"},
            "node_count": {"const": 20},
            "methods": {
              "type": "array",
              "items": {"type": "string"},
              "minItems": 10,
              "maxItems": 10,
              "uniqueItems": true
            },
            "loads": {
              "type": "array",
              "items": {"enum": ["low", "middle", "high"]},
              "minItems": 3,
              "maxItems": 3,
              "uniqueItems": true
            },
            "seeds": {
              "type": "array",
              "items": {"pattern": "^E[0-9]{2}$"},
              "minItems": 10,
              "maxItems": 20,
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "selected_source_runs": {
          "type": "array",
          "items": {"$ref": "#/$defs/formalE1SourceRun"},
          "minItems": 300,
          "maxItems": 600
        },
        "sealed_reuse_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rule_id", "rule_sha256"],
            "properties": {
              "rule_id": {"type": "string", "minLength": 1},
              "rule_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            },
            "additionalProperties": false
          }
        },
        "selected_run_count": {"enum": [300, 600]},
        "selected_cell_count": {"const": 30},
        "selected_reference_build_count": {"enum": [30, 60]}
      },
      "additionalProperties": false
    },
    "formalE1SourceRun": {
      "type": "object",
      "required": [
        "source_run_id",
        "source_run_spec_hash",
        "source_cell_id",
        "source_method",
        "source_variant",
        "source_seed",
        "source_workload_spec_hash",
        "source_workload_tape_key",
        "source_cluster_sha256",
        "source_simulation_sha256",
        "source_environment_sha256",
        "source_common_hpa_hash"
      ],
      "properties": {
        "source_run_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "source_run_spec_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_cell_id": {"type": "string", "minLength": 1},
        "source_method": {"type": "string", "minLength": 1},
        "source_variant": {"const": "full"},
        "source_seed": {"pattern": "^E[0-9]{2}$"},
        "source_workload_spec_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_workload_tape_key": {"type": "string", "minLength": 1},
        "source_cluster_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_simulation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_environment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_common_hpa_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "reuseAnalysis": {
      "oneOf": [
        {"$ref": "#/$defs/reuseCells"},
        {"$ref": "#/$defs/analysisOnly"}
      ]
    },
    "reuseCells": {
      "type": "object",
      "required": [
        "schema_version",
        "rule_id",
        "rule_sha256",
        "experiment_id",
        "kind",
        "source_experiment_id",
        "source_selector",
        "compatibility",
        "target_projection",
        "purpose"
      ],
      "properties": {
        "schema_version": {"const": "NSE_ANALYSIS_REUSE_RULE_V1"},
        "rule_id": {"type": "string", "minLength": 1},
        "rule_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "experiment_id": {"enum": ["E2", "E5", "E6", "E7"]},
        "kind": {"const": "reuse_cells"},
        "source_experiment_id": {"const": "E1"},
        "source_selector": {"type": "object", "minProperties": 1},
        "compatibility": {
          "type": "object",
          "required": [
            "workload_transform",
            "cluster_transform",
            "required_exact",
            "required_hash_fields"
          ],
          "properties": {
            "workload_transform": {"const": "identity"},
            "cluster_transform": {"const": "identity"},
            "required_exact": {"type": "object"},
            "required_by_load": {"type": "object"},
            "required_hash_fields": {
              "type": "array",
              "items": {"type": "string"},
              "minItems": 3,
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "target_projection": {
          "type": "object",
          "required": ["scenario", "variant", "cell_id_template"],
          "properties": {
            "scenario": {"type": "string", "minLength": 1},
            "variant": {"type": "string"},
            "cell_id_template": {"type": "string", "minLength": 1},
            "copy_nash_parameters": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "purpose": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "analysisOnly": {
      "type": "object",
      "required": [
        "schema_version",
        "rule_id",
        "rule_sha256",
        "experiment_id",
        "kind",
        "source_experiment_ids",
        "produces_runs"
      ],
      "properties": {
        "schema_version": {"const": "NSE_ANALYSIS_REUSE_RULE_V1"},
        "rule_id": {"type": "string", "minLength": 1},
        "rule_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "experiment_id": {"enum": ["E8", "E9"]},
        "kind": {"const": "analysis_only"},
        "source_experiment_ids": {
          "type": "array",
          "items": {"pattern": "^E[1-7]$"},
          "minItems": 1,
          "uniqueItems": true
        },
        "produces_runs": {"const": false}
      },
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "required": [
        "run_id",
        "run_spec_hash",
        "cell_id",
        "experiment_id",
        "method",
        "seed",
        "workload",
        "workload_profile",
        "workload_spec_hash",
        "workload_tape",
        "cluster",
        "common_hpa",
        "common_hpa_hash",
        "simulation",
        "simulator_experiment",
        "environment"
      ],
      "properties": {
        "run_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "run_spec_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "cell_id": {"type": "string", "minLength": 1},
        "experiment_id": {"pattern": "^E[1-7]$"},
        "method": {"type": "string", "minLength": 1},
        "seed": {"pattern": "^E[0-9]{2}$"},
        "workload": {"type": "object"},
        "workload_profile": {"$ref": "#/$defs/workloadProfileBinding"},
        "workload_spec_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "workload_tape": {"type": "object"},
        "cluster": {"type": "object"},
        "common_hpa": {"type": "object"},
        "common_hpa_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "simulation": {"type": "object"},
        "simulator_experiment": {
          "type": "object",
          "required": ["protocol_version", "run_id", "workload", "qos", "faasrank_model", "nash", "ablation", "reference", "output"],
          "properties": {"protocol_version": {"const": "reviewer-v3"}}
        },
        "reference_dependency": {"$ref": "#/$defs/referenceDependency"},
        "environment": {"type": "object", "additionalProperties": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "workloadProfileBinding": {
      "type": "object",
      "required": [
        "schema_version",
        "profile_set_id",
        "profile_id",
        "load",
        "path",
        "sha256",
        "dag_call_frequency_sha256",
        "dag_count",
        "expected_arrival_rate_rps",
        "submission_actual_arrival_rate_rps",
        "request_frequency_scale",
        "source"
      ],
      "properties": {
        "schema_version": {"const": "NSE_WORKLOAD_FREQUENCY_PROFILE_V1"},
        "profile_set_id": {"const": "submission-era-azure-cdf-v1"},
        "profile_id": {"type": "string", "minLength": 1},
        "load": {"enum": ["low", "middle", "high"]},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "dag_call_frequency_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "dag_count": {"const": 50},
        "expected_arrival_rate_rps": {"type": "number", "exclusiveMinimum": 0},
        "submission_actual_arrival_rate_rps": {"type": "number", "exclusiveMinimum": 0},
        "request_frequency_scale": {"type": "number", "exclusiveMinimum": 0},
        "source": {"type": "object"}
      },
      "additionalProperties": false
    },
    "referenceDependency": {
      "type": "object",
      "required": [
        "schema_version",
        "key",
        "path",
        "sha256",
        "build_required",
        "build_spec_hash",
        "build_experiment"
      ],
      "properties": {
        "schema_version": {"const": "NSE_REFERENCE_DEPENDENCY_V1"},
        "key": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "build_required": {"type": "boolean"},
        "build_spec_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "build_experiment": {"type": "object"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
