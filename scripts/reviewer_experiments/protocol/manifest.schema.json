        "sealed_reuse_rules": {"type": "array", "items": {"$ref": "#/$defs/sealedReuseRule"}},
        "selected_run_count": {"const": 400},
        "selected_cell_count": {"const": 40},
        "selected_e3_run_count": {"const": 300},
        "selected_e4_run_count": {"const": 100},
        "selected_reference_build_count": {"const": 40},
        "selected_balanced_qos_run_count": {"const": 400},
        "selected_faasrank_run_count": {"const": 40}
      },
      "additionalProperties": false
    },
    "formalE5E6E7InitialShard": {
      "type": "object",
      "required": [
        "schema_version",
        "source_manifest",
        "selection",
        "selected_source_runs",
        "e1_reuse_lineage",
        "sealed_reuse_rules",
        "sealed_e1_reuse_rules",
        "selected_physical_run_count",
        "selected_physical_cell_count",
        "reference_build_count",
        "e1_reuse_projection_count",
        "e1_reuse_unique_source_run_count"
      ],
      "properties": {
        "schema_version": {"const": "NSE_FORMAL_E5_E6_E7_INITIAL_SHARD_V1"},
        "source_manifest": {
          "type": "object",
